name = "totto2727/tui"

version = "0.10.2"

import {
  "mizchi/layout@0.2.1",
  "mizchi/crater-core@0.19.2",
  "mizchi/crater-layout@0.19.2",
  "mizchi/css@0.8.0",
  "mizchi/signals@0.6.5",
  "mizchi/tui-terminal-buffer@0.1.4",
  "moonbitlang/async@0.22.9",
  "totto2727/syntree@0.2.4",
  "moonbitlang/x@0.5.7",
}

readme = "README.md"

repository = "https://github.com/totto2727-org/tui.mbt"

license = "MIT"

keywords = [ "tui", "terminal", "ui", "cli" ]

description = "Terminal UI library for MoonBit with reactive signals"

preferred_target = "js"

source = "src"
